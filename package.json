{
  "name": "@47stats/api",
  "description": "47都道府県統計データAPIのTypeScriptクライアントライブラリ",
  "version": "0.9.1",
  "author": "team 47stats",
  "bugs": {
    "url": "https://github.com/47stats/47stats-api/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.2.3",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.2",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.umd.cjs",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://www.47stats.com/",
  "keywords": [
    "47stats",
    "47stats-api",
    "typescript"
  ],
  "license": "MIT",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/47stats/47stats-api"
  },
  "scripts": {
    "build": "vite build && npm run types:build",
    "build:watch": "vite build --watch",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "npm:pack": "npm pack",
    "preview": "vite preview",
    "test": "vitest --mode test",
    "test:watch": "vitest --watch --mode test",
    "type-check": "tsc --noEmit",
    "types:build": "tsc -p tsconfig.lib.json"
  },
  "type": "module",
  "types": "dist/types/index.d.ts",
  "dependencies": {
    "@types/geojson": "^7946.0.16"
  }
}
